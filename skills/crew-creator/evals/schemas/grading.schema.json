{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://pi-bebop.dev/schemas/crew-eval-grading-1.0.json",
	"title": "Crew evaluation grading result",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "evalId", "caseId", "runId", "deliverable", "assertions", "infrastructure"],
	"properties": {
		"schemaVersion": { "const": "1.0" },
		"evalId": { "$ref": "crew-evals.schema.json#/$defs/id" },
		"caseId": { "$ref": "crew-evals.schema.json#/$defs/id" },
		"runId": { "$ref": "crew-evals.schema.json#/$defs/id" },
		"deliverable": { "$ref": "#/$defs/deliverable" },
		"assertions": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/assertion" }
		},
		"infrastructure": { "$ref": "#/$defs/infrastructure" },
		"semanticGrader": { "$ref": "#/$defs/grader" },
		"terminalResult": { "enum": ["passed", "failed", "invalid_infrastructure", "unknown"] }
	},
	"$defs": {
		"deliverable": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "status"],
			"properties": {
				"id": { "$ref": "crew-evals.schema.json#/$defs/id" },
				"status": { "enum": ["present", "missing", "ambiguous", "malformed"] },
				"path": { "$ref": "crew-evals.schema.json#/$defs/relativePath" },
				"sha256": { "$ref": "crew-evals.schema.json#/$defs/sha256" },
				"selector": { "type": "string", "minLength": 1, "maxLength": 256 }
			},
			"allOf": [
				{
					"if": { "properties": { "status": { "const": "present" } } },
					"then": { "anyOf": [{ "required": ["path"] }, { "required": ["selector"] }] }
				},
				{
					"if": { "properties": { "status": { "enum": ["missing", "ambiguous", "malformed"] } } },
					"then": { "not": { "required": ["sha256"] } }
				}
			]
		},
		"assertion": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "authority", "status", "evidence"],
			"properties": {
				"id": { "$ref": "crew-evals.schema.json#/$defs/id" },
				"authority": { "enum": ["deterministic", "gold", "semantic"] },
				"status": { "enum": ["passed", "failed", "not_run"] },
				"score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
				"evidence": {
					"type": "array",
					"items": { "$ref": "#/$defs/evidence" },
					"minItems": 1
				},
				"reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
			}
		},
		"evidence": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "path", "selector"],
			"properties": {
				"kind": { "enum": ["output", "transcript", "timing", "message_trace"] },
				"path": { "$ref": "crew-evals.schema.json#/$defs/relativePath" },
				"selector": { "type": "string", "minLength": 1, "maxLength": 256 },
				"sha256": { "$ref": "crew-evals.schema.json#/$defs/sha256" }
			}
		},
		"infrastructure": {
			"type": "object",
			"additionalProperties": false,
			"required": ["status"],
			"properties": {
				"status": { "enum": ["none", "error"] },
				"code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
				"summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
				"evidence": {
					"type": "array",
					"items": { "$ref": "#/$defs/evidence" }
				}
			},
			"allOf": [
				{
					"if": { "properties": { "status": { "const": "error" } } },
					"then": { "required": ["code", "summary", "evidence"] }
				},
				{
					"if": { "properties": { "status": { "const": "none" } } },
					"then": { "not": { "required": ["code"] } }
				}
			]
		},
		"grader": {
			"type": "object",
			"additionalProperties": false,
			"required": ["provider", "model", "thinking", "configurationSource"],
			"properties": {
				"provider": { "type": "string", "minLength": 1, "maxLength": 128 },
				"model": { "type": "string", "minLength": 1, "maxLength": 256 },
				"thinking": { "type": "string", "minLength": 1, "maxLength": 64 },
				"configurationSource": { "enum": ["runner", "startup"] }
			}
		}
	}
}
