{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://pi-bebop.dev/schemas/crew-eval-run-1.0.json",
	"title": "Comparative Crew evaluation run metadata",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"evalId",
		"caseId",
		"runId",
		"comparisonSide",
		"repetition",
		"templateSnapshot",
		"manifest",
		"members",
		"runnerVersion",
		"timeoutMs",
		"concurrency",
		"startedAt",
		"endedAt",
		"terminalStatus"
	],
	"properties": {
		"schemaVersion": { "const": "1.0" },
		"evalId": { "$ref": "crew-evals.schema.json#/$defs/id" },
		"caseId": { "$ref": "crew-evals.schema.json#/$defs/id" },
		"runId": { "$ref": "crew-evals.schema.json#/$defs/id" },
		"comparisonSide": { "enum": ["with_crew", "baseline"] },
		"repetition": { "type": "integer", "minimum": 1, "maximum": 1000 },
		"templateSnapshot": { "$ref": "#/$defs/snapshot" },
		"manifest": { "$ref": "#/$defs/snapshot" },
		"members": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/member" }
		},
		"runnerVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
		"timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
		"concurrency": { "$ref": "#/$defs/concurrency" },
		"startedAt": { "type": "string", "format": "date-time" },
		"endedAt": { "type": "string", "format": "date-time" },
		"terminalStatus": {
			"enum": ["passed", "assertion_failed", "infrastructure_error", "cancelled", "unknown"]
		},
		"infrastructureError": { "$ref": "#/$defs/error" },
		"notes": { "type": "string", "maxLength": 4000 }
	},
	"allOf": [
		{
			"if": { "properties": { "terminalStatus": { "const": "infrastructure_error" } } },
			"then": { "required": ["infrastructureError"] }
		},
		{
			"if": { "properties": { "terminalStatus": { "enum": ["passed", "assertion_failed"] } } },
			"then": { "not": { "required": ["infrastructureError"] } }
		}
	],
	"$defs": {
		"snapshot": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "sha256"],
			"properties": {
				"path": { "$ref": "crew-evals.schema.json#/$defs/relativePath" },
				"sha256": { "$ref": "crew-evals.schema.json#/$defs/sha256" }
			}
		},
		"member": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "role", "provider", "model", "thinking"],
			"properties": {
				"name": {
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,63}$"
				},
				"role": { "type": "string", "minLength": 1, "maxLength": 64 },
				"provider": { "type": "string", "minLength": 1, "maxLength": 128 },
				"model": { "type": "string", "minLength": 1, "maxLength": 256 },
				"thinking": { "type": "string", "minLength": 1, "maxLength": 64 },
				"configurationSource": { "enum": ["runner", "startup"] }
			}
		},
		"concurrency": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "maxMembers"],
			"properties": {
				"mode": { "enum": ["serial", "parallel"] },
				"maxMembers": { "type": "integer", "minimum": 1, "maximum": 128 }
			}
		},
		"error": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "summary"],
			"properties": {
				"code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
				"summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
				"evidenceRef": { "$ref": "crew-evals.schema.json#/$defs/relativePath" }
			}
		}
	}
}
