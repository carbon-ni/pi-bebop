{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true,
		"outDir": "dist",
		"allowImportingTsExtensions": true
	},
	"include": ["index.ts", "src/**/*.ts"],
	"exclude": ["**/*.test.ts"]
}
