{
	"name": "pi-bebop",
	"version": "0.1.0",
	"description": "Independent crew management for Pi agents",
	"type": "module",
	"main": "./dist/extension.js",
	"bin": {
		"pi-bebop": "./dist/cli/main.js"
	},
	"files": [
		"index.ts",
		"src/application/direct-message.ts",
		"src/application/member-message.ts",
		"src/domain/branch-alias.ts",
		"src/domain/cli.ts",
		"src/domain/crew-roster.ts",
		"src/domain/crew-manifest.ts",
		"src/domain/index.ts",
		"src/domain/messages.ts",
		"src/domain/message-payload.ts",
		"src/domain/message-renderer.ts",
		"src/domain/protocol.ts",
		"src/domain/response-policy.ts",
		"src/domain/session-filter.ts",
		"src/domain/session-id.ts",
		"src/domain/session-messages.ts",
		"src/extension.ts",
		"src/infra/control-store.ts",
		"src/infra/crew-manifest-store.ts",
		"src/infra/git-branch.ts",
		"src/infra/intray-config.ts",
		"src/infra/intray-paths.ts",
		"src/infra/member-endpoint.ts",
		"src/infra/membership-runtime.ts",
		"src/infra/rpc-client.ts",
		"src/infra/rpc-server.ts",
		"src/infra/session-env.ts",
		"src/infra/socket-endpoint.ts",
		"src/pi/control-commands.ts",
		"src/pi/control-runtime.ts",
		"src/pi/membership-context.ts",
		"src/pi/membership-lifecycle.ts",
		"src/pi/message-renderer.ts",
		"src/pi/startup-send.ts",
		"src/tools/index.ts",
		"src/tools/list-sessions.ts",
		"src/tools/send-message.ts",
		"src/tools/member-tool-adapter.ts",
		"src/tools/send-follow-up.ts",
		"src/tools/send-immediate.ts",
		"src/tools/send-to-session.ts",
		"src/tools/session-target.ts",
		"dist/cli/main.js",
		"dist/extension.js",
		"README.md",
		"docs",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/extension.js"
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "npm run typecheck",
		"prepack": "npm run build",
		"verify:package": "node scripts/verify-package.mjs",
		"pretest": "npm run build",
		"test": "node scripts/run-tests.mjs",
		"test:coverage": "node --test --experimental-test-coverage --import tsx src/**/*.test.ts",
		"format:check": "prettier --check \"src/**/*.ts\" index.ts \"scripts/**/*.mjs\" package.json .watch.yaml .prettierrc.json tsconfig.json",
		"format:write": "prettier --write \"src/**/*.ts\" index.ts \"scripts/**/*.mjs\" package.json .watch.yaml .prettierrc.json tsconfig.json",
		"check:package-json": "node scripts/check-package-json.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.84.2 <0.85.0",
		"@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0",
		"@earendil-works/pi-tui": ">=0.84.2 <0.85.0",
		"@sinclair/typebox": ">=0.34.50 <0.35.0",
		"typebox": ">=1.1.38 <1.2.0"
	},
	"dependencies": {
		"@toon-format/toon": "4.1.1"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@sinclair/typebox": "0.34.50",
		"@types/node": "^22.13.0",
		"esbuild": "^0.25.12",
		"prettier": "3.6.2",
		"tsx": "^4.20.5",
		"typebox": "1.1.38",
		"typescript": "^5.8.3"
	}
}
